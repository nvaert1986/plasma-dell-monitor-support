[Desktop Entry]
Type=Application
Name=Plasma Dell Monitor Support
GenericName=Monitor Control
Comment=Control Dell monitor settings over DDC/CI
Icon=monitor
Exec=python3 /path/to/plasma-dell-monitor-support/main.py
Terminal=false
